<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): solid brand navy, the hourglass mark inside the 66 dp
     safe zone, and a monochrome layer for themed icons (Android 13+).
     Bitmaps and the monochrome vector are generated by android/tools/generate_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
