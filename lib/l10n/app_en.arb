  "@wageCheckConfirmTitle": {
    "description": "Dialog title when a newly entered hourly rate looks implausible (below 5 or above 100 €/h).",
    "placeholders": {"rate": {"type": "String", "example": "€1,250.00/h"}}
  },
  "wageCheckConfirmYes": "Yes, that's right",
  "@wageCheckConfirmYes": {"description": "Dialog button that keeps an unusual hourly rate."},
  "wageCheckConfirmEdit": "Change",
  "@wageCheckConfirmEdit": {"description": "Dialog button that goes back to correct the hourly rate."},

