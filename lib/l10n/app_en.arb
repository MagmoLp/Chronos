  "privacyUpdated": "Last updated: 30 September 2026 (applies from version 2.0)",
  "@privacyUpdated": {
    "description": "Privacy policy: date line."
  },
  "privacyIntro": "This privacy policy applies to the Android app Chronos – Stundenlohn Tracker, developed by Paul Hübner.",
  "@privacyIntro": {
    "description": "Privacy policy: scope. Keep the app name as is."
  },
  "privacyShortTitle": "In short",
  "@privacyShortTitle": {
    "description": "Privacy policy heading."
  },
  "privacyShortBody": "Everything you enter in Chronos stays on your device. There is no account, no advertising, no analytics and no tracking. The app has no internet permission and sends nothing to the developer or to third parties.",
  "@privacyShortBody": {
    "description": "Privacy policy: summary."
  },
  "privacyStoredTitle": "What the app stores",
  "@privacyStoredTitle": {
    "description": "Privacy policy heading."
  },
  "privacyStoredIntro": "Chronos stores data only in the app's private storage on your device:",
  "@privacyStoredIntro": {
    "description": "Privacy policy: intro of the list of stored data."
  },
  "privacyStoredShifts": "shifts with start, end, breaks, tips, notes and their “open/paid” status,",
  "@privacyStoredShifts": {
    "description": "Privacy policy list item."
  },
  "privacyStoredJobs": "jobs with name, colour, hourly wage and wage history,",
  "@privacyStoredJobs": {
    "description": "Privacy policy list item."
  },
  "privacyStoredPayouts": "recorded payouts,",
  "@privacyStoredPayouts": {
    "description": "Privacy policy list item."
  },
  "privacyStoredSettings": "settings (e.g. language, theme, monthly goal, reminder),",
  "@privacyStoredSettings": {
    "description": "Privacy policy list item."
  },
  "privacyStoredErrorLog": "a local error log with technical error messages for troubleshooting.",
  "@privacyStoredErrorLog": {
    "description": "Privacy policy list item."
  },
  "privacyStoredNoAccess": "The developer has no access to this data.",
  "@privacyStoredNoAccess": {
    "description": "Privacy policy sentence."
  },
  "privacyExceptionsTitle": "Exceptions you control",
  "@privacyExceptionsTitle": {
    "description": "Privacy policy heading."
  },
  "privacyAutoBackupTitle": "Android backup (Auto Backup)",
  "@privacyAutoBackupTitle": {
    "description": "Privacy policy sub-heading."
  },
  "privacyAutoBackupBody": "If backup is switched on in your device's Android settings, Android automatically backs up Chronos' data (database and settings) to your own Google account and restores it when you reinstall the app or move to a new device. This is an operating-system feature provided to you by Google; the developer cannot see these backups. On Android 9 and later they are end-to-end encrypted with your screen lock. You can switch backup off in the Android settings (usually under “System” or “Google” → “Backup”) and delete existing backups from your Google account. A direct transfer to a new device (cable or Wi-Fi) takes the same data along.",
  "@privacyAutoBackupBody": {
    "description": "Privacy policy paragraph."
  },
  "privacyExportTitle": "Export, backup file and error report",
  "@privacyExportTitle": {
    "description": "Privacy policy sub-heading."
  },
  "privacyExportBody": "Only when you explicitly ask for it, Chronos creates a file (PDF timesheet, CSV, JSON backup or the error log) and opens the Android share sheet. You decide which app or recipient receives the file (e.g. e-mail, messenger, cloud storage). From then on, that service's terms apply.",
  "@privacyExportBody": {
    "description": "Privacy policy paragraph."
  },
  "privacyRestoreTitle": "Restoring a backup",
  "@privacyRestoreTitle": {
    "description": "Privacy policy sub-heading."
  },
  "privacyRestoreBody": "Using the Android file picker, Chronos reads only the single file you select.",
  "@privacyRestoreBody": {
    "description": "Privacy policy paragraph."
  },
  "privacyPermissionsTitle": "Notifications and permissions",
  "@privacyPermissionsTitle": {
    "description": "Privacy policy heading."
  },
  "privacyPermissionNotifications": "Show notifications (optional): for the running shift with a stopwatch and the “Still working?” reminder. Notifications are created on the device; no push service is used. Without this permission the app keeps working normally.",
  "@privacyPermissionNotifications": {
    "description": "Privacy policy list item."
  },
  "privacyPermissionBoot": "Run at startup: so that a scheduled reminder is scheduled again after a restart.",
  "@privacyPermissionBoot": {
    "description": "Privacy policy list item."
  },
  "privacyPermissionsNone": "Chronos does not request permissions for the internet, location, contacts, camera or shared storage.",
  "@privacyPermissionsNone": {
    "description": "Privacy policy paragraph."
  },
  "privacyNoSharingTitle": "No sharing, no advertising, no tracking",
  "@privacyNoSharingTitle": {
    "description": "Privacy policy heading."
  },
  "privacyNoSharingBody": "Chronos contains no advertising, no analytics tools, no tracking SDKs and no crash reporting to external servers. No data is sold or passed on to third parties.",
  "@privacyNoSharingBody": {
    "description": "Privacy policy paragraph."
  },
  "privacyDeleteTitle": "Deleting your data",
  "@privacyDeleteTitle": {
    "description": "Privacy policy heading."
  },
  "privacyDeleteBody": "In the app via “Settings → Data → Delete all data”, or by uninstalling the app or clearing its storage in the Android settings. Backups in your Google account are managed in your Google or Android settings.",
  "@privacyDeleteBody": {
    "description": "Privacy policy paragraph."
  },
  "privacyChangesTitle": "Changes",
