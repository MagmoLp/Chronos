  "commonDone": "Done",
  "@commonDone": {"description": "Button that finishes a flow."},
  "commonNext": "Next",
  "@commonNext": {"description": "Button that moves to the next step of a flow."},
  "commonBack": "Back",
  "@commonBack": {"description": "Button that moves to the previous step of a flow."},
  "commonShare": "Share",
  "@commonShare": {"description": "Button that opens the system share sheet."},
  "commonSettings": "Settings",
  "@commonSettings": {"description": "Tooltip of the gear icon in every top app bar; also the settings screen title."},
  "commonOk": "OK",
