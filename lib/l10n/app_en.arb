  "commonAdd": "Add",
  "@commonAdd": {"description": "Generic button: add a new item."},
  "commonExport": "Export",
  "@commonExport": {"description": "Generic button or menu item: export data (PDF/CSV)."},
  "commonDismiss": "Dismiss",
