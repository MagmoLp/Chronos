  "@onboardingRateHelper": {"description": "Helper text below the hourly rate field."},
  "onboardingMoreJobsLater": "You can add more jobs later in Settings.",
  "@onboardingMoreJobsLater": {"description": "Hint below the Done button of the job step."},

  "wageCheckTitle": "{rate} taken over – is that right?",
  "@wageCheckTitle": {
    "description": "Question after importing old data whose hourly rate looks implausible. {rate} is a formatted rate such as '€1,250.00/h'.",
    "placeholders": {"rate": {"type": "String", "example": "€1,250.00/h"}}
  },
  "wageCheckTooHigh": "That's unusually high. The old version sometimes lost the decimal separator, so 12.50 became 1250.",
  "@wageCheckTooHigh": {"description": "Explanation when the imported hourly rate is above 100 €/h."},
  "wageCheckTooLow": "That's unusually low for an hourly rate.",
  "@wageCheckTooLow": {"description": "Explanation when an hourly rate is below 5 €/h (imported or newly entered)."},
  "wageCheckUnusuallyHigh": "That's unusually high for an hourly rate.",
  "@wageCheckUnusuallyHigh": {"description": "Explanation when a newly entered hourly rate is above 100 €/h."},
  "wageCheckFieldLabel": "Correct hourly rate",
  "@wageCheckFieldLabel": {"description": "Label of the field for the corrected hourly rate."},
  "wageCheckFieldHelper": "Applies to the job and to all shifts taken over.",
  "@wageCheckFieldHelper": {"description": "Helper text below the corrected hourly rate field."},
  "wageCheckFix": "Use this rate",
  "@wageCheckFix": {"description": "Primary button that saves the corrected hourly rate."},
  "wageCheckKeep": "Keep {rate}",
  "@wageCheckKeep": {
    "description": "Button that confirms the imported rate is correct.",
    "placeholders": {"rate": {"type": "String", "example": "€1,250.00/h"}}
  },
  "wageCheckFixed": "{count, plural, =0{Hourly rate corrected} =1{Hourly rate corrected · 1 shift updated} other{Hourly rate corrected · {count} shifts updated}}",
  "@wageCheckFixed": {
    "description": "Snackbar after the imported hourly rate was corrected.",
    "placeholders": {"count": {"type": "int"}}
  },
